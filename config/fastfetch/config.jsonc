{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "left": 2
        },
        "color": {
            "1": "magenta",
            "2": "cyan"
        }
    },
    "display": {
        "separator": " ──❯ ",
        "color": {
            "keys": "magenta",
            "title": "cyan"
        }
    },
    "modules": [
        "title",
        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────────┐",
            "outputColor": "bright_black"
        },
        {
            "type": "os",
            "key": "  󰠳 OS      ",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "  󰌽 Kernel  ",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": "  󱎫 Uptime  ",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "  󰏖 Packages",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": "  󱆃 Shell   ",
            "keyColor": "magenta"
        },
        {
            "type": "terminal",
            "key": "  󰞷 Terminal",
            "keyColor": "yellow"
        },
        {
            "type": "custom",
            "format": "├──────────────────────────────────────────────┤",
            "outputColor": "bright_black"
        },
        {
            "type": "cpu",
            "key": "  󰻠 CPU     ",
            "keyColor": "cyan",
            "format": "{1} ({4}) @ {7} GHz"
        },
        {
            "type": "memory",
            "key": "  󰍛 Memory  ",
            "keyColor": "magenta",
            "format": "{} / {} ({3})"
        },
        {
            "type": "disk",
            "key": "  󰋊 Disk    ",
            "keyColor": "yellow",
            "format": "{1} / {2} ({9})"
        },
        {
            "type": "localip",
            "key": "  󰩟 Local IP",
            "keyColor": "cyan"
        },
        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────┘",
            "outputColor": "bright_black"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
